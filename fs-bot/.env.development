# 开发环境配置 (Development)

# 应用标题
VITE_APP_TITLE=fs-bot (Dev)

# 应用版本
VITE_APP_VERSION=1.0.0

# 自动更新地址
VITE_UPDATE_URL=https://example.com/auto-updates

# 后台管理接口地址
